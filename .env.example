# ─────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
APP_NAME="Lenny Growth Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT=development   # development | production
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────
# For local dev: postgresql://user:password@localhost:5432/dbname
# For Docker:    postgresql://lenny:lenny@postgres:5432/lenny_db
DATABASE_URL=postgresql://lenny:lenny@localhost:5432/lenny_db

# ── Vector Store ──────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/embeddings
CHROMA_COLLECTION=lenny_transcripts

# ── LLM Provider Selection ────────────────────────────────────────
# Options: ollama | anthropic | openai
# Use 'ollama' for local/demo (no API key needed)
LLM_PROVIDER=ollama

# ── Model Parameters ─────────────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ── Anthropic (required if LLM_PROVIDER=anthropic) ───────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model is configurable — update without code changes:
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── OpenAI (required if LLM_PROVIDER=openai) ─────────────────────
# Get yours at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Ollama (local LLM — no key needed) ───────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Any model available in your local Ollama install:
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# ── Embeddings (local — no key needed) ───────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu   # cpu | cuda | mps (Apple Silicon)

# ── RAG Parameters ────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_MIN_SCORE=0.3

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Session Context Window ────────────────────────────────────────
MAX_HISTORY_MESSAGES=20
